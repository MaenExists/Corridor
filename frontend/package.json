{
  "name": "narcotrace-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "ppt": "node scripts/sync-ppt.mjs",
    "build": "npm run ppt && next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test lib/*.test.ts",
    "cf:bundle": "node scripts/cf-bundle.mjs",
    "cf:build": "npm run ppt && npm run cf:bundle && NT_BUNDLE=1 opennextjs-cloudflare build",
    "deploy:cf": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-malayalam": "^5.3.0",
    "geist": "^1.9.2",
    "leaflet": "^1.9.4",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "wrangler": "^4.168.0"
  }
}
