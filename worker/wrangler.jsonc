{
  "name": "narcotrace-local",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-25",
  "send_metrics": false,
  "dev": { "ip": "127.0.0.1", "port": 8787, "inspector_port": 9231 },
  "assets": { "directory": "../web/public/generated", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "narcotrace-demo",
    "database_id": "4d861358-4e50-4c79-a6e3-650e97ad256d",
    "migrations_dir": "migrations"
  }]
}
